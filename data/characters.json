    {"char": "碰", "level": "G2-U10", "pinyin": "pèng", "words": [{"word": "碰上", "pinyin": ["pèng", "shàng"], "audio": "audio/3b9da160bfae.mp3"}, {"word": "碰面", "pinyin": ["pèng", "miàn"], "audio": "audio/b00f3e954849.mp3"}], "lesson": "10.2", "lessonTitle": "要是你在野外迷了路", "kind": "write", "audio": "audio/4c1aa9b9bf59.mp3", "sentence": {"text": "要是碰上阴雨天，大树也会来帮忙。", "pinyin": ["yào", "shì", "pèng", "shàng", "yīn", "yǔ", "tiān", "", "dà", "shù", "yě", "huì", "lái", "bāng", "máng", ""], "audio": "audio/d6a565d58427.mp3"}},
    {"char": "积", "level": "G2-U10", "pinyin": "jī", "words": [{"word": "积雪", "pinyin": ["jī", "xuě"], "audio": "audio/e446c21256ee.mp3"}, {"word": "积累", "pinyin": ["jī", "lěi"], "audio": "audio/9a7d688e161a.mp3"}], "lesson": "10.2", "lessonTitle": "要是你在野外迷了路", "kind": "write", "audio": "audio/3f348af0af86.mp3", "sentence": {"text": "雪特别怕太阳，沟渠里的积雪会给你指点方向。", "pinyin": ["xuě", "tè", "bié", "pà", "tài", "yáng", "", "gōu", "qú", "lǐ", "de", "jī", "xuě", "huì", "gěi", "nǐ", "zhǐ", "diǎn", "fāng", "xiàng", ""], "audio": "audio/bc8fb3f0f5b1.mp3"}},
