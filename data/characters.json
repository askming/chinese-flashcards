    {"char": "座", "level": "G2-U10", "pinyin": "zuò", "words": [{"word": "一座高楼", "pinyin": ["yí", "zuò", "gāo", "lóu"], "audio": "audio/acbaf5ea4661.mp3"}, {"word": "一座山", "pinyin": ["yí", "zuò", "shān"], "audio": "audio/58e81b059fa0.mp3"}, {"word": "一座石桥", "pinyin": ["yí", "zuò", "shí", "qiáo"], "audio": "audio/df56e43e32ce.mp3"}, {"word": "让座", "pinyin": ["ràng", "zuò"], "audio": "audio/5f282e96a8d8.mp3"}], "lesson": "10.5", "lessonTitle": "回声", "kind": "write", "audio": "audio/c9a97f2343ac.mp3", "sentence": {"text": "小河上有座石桥。", "pinyin": ["xiǎo", "hé", "shàng", "yǒu", "zuò", "shí", "qiáo", ""], "audio": "audio/e28188338c1e.mp3"}},
    {"char": "桥", "level": "G2-U10", "pinyin": "qiáo", "words": [{"word": "一座石桥", "pinyin": ["yí", "zuò", "shí", "qiáo"], "audio": "audio/df56e43e32ce.mp3"}, {"word": "桥洞", "pinyin": ["qiáo", "dòng"], "audio": "audio/e3a6a1d41f52.mp3"}, {"word": "小桥流水", "pinyin": ["xiǎo", "qiáo", "liú", "shuǐ"], "audio": "audio/542088c3c8a1.mp3"}], "lesson": "10.5", "lessonTitle": "回声", "kind": "write", "audio": "audio/f73630b6cb02.mp3", "sentence": {"text": "桥洞里立刻响起一片呱呱的回声。", "pinyin": ["qiáo", "dòng", "lǐ", "lì", "kè", "xiǎng", "qǐ", "yí", "piàn", "guā", "guā", "de", "huí", "shēng", ""], "audio": "audio/4fc113cca1fe.mp3"}},
