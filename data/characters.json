    {"char": "影", "level": "G2-U10", "pinyin": "yǐng", "words": [{"word": "倒影", "pinyin": ["dào", "yǐng"], "audio": "audio/8839cbe55e49.mp3"}, {"word": "电影", "pinyin": ["diàn", "yǐng"], "audio": "audio/7cf127eb3d3e.mp3"}], "lesson": "10.5", "lessonTitle": "回声", "kind": "recognize", "audio": "audio/a335f6a3a1e0.mp3", "sentence": {"text": "半圆的桥洞和水里的倒影连起来，好像一个大月亮。", "pinyin": ["bàn", "yuán", "de", "qiáo", "dòng", "hé", "shuǐ", "lǐ", "de", "dào", "yǐng", "lián", "qǐ", "lái", "", "hǎo", "xiàng", "yí", "gè", "dà", "yuè", "liàng", ""], "audio": "audio/e583158983e1.mp3"}},
    {"char": "颗", "level": "G2-U10", "pinyin": "kē", "words": [{"word": "一颗石子", "pinyin": ["yì", "kē", "shí", "zǐ"], "audio": "audio/d54cb2b24bdd.mp3"}], "lesson": "10.5", "lessonTitle": "回声", "kind": "recognize", "audio": "audio/f262bf6227e7.mp3", "sentence": {"text": "她捡起一颗石子，扔进河里，河水被激起一圈圈波纹。", "pinyin": ["tā", "jiǎn", "qǐ", "yì", "kē", "shí", "zǐ", "", "rēng", "jìn", "hé", "lǐ", "", "hé", "shuǐ", "bèi", "jī", "qǐ", "yì", "quān", "quān", "bō", "wén", ""], "audio": "audio/93b2742f60dd.mp3"}},
    {"char": "圈", "level": "G2-U10", "pinyin": "quān", "words": [{"word": "圆圈", "pinyin": ["yuán", "quān"], "audio": "audio/7cb3a6c94171.mp3"}, {"word": "一圈圈波纹", "pinyin": ["yì", "quān", "quān", "bō", "wén"], "audio": "audio/24904e9bd537.mp3"}, {"word": "黑眼圈", "pinyin": ["hēi", "yǎn", "quān"], "audio": "audio/9476d5e22865.mp3"}], "lesson": "10.5", "lessonTitle": "回声", "kind": "recognize", "audio": "audio/413c5cf52d75.mp3", "sentence": {"text": "她捡起一颗石子，扔进河里，河水被激起一圈圈波纹。", "pinyin": ["tā", "jiǎn", "qǐ", "yì", "kē", "shí", "zǐ", "", "rēng", "jìn", "hé", "lǐ", "", "hé", "shuǐ", "bèi", "jī", "qǐ", "yì", "quān", "quān", "bō", "wén", ""], "audio": "audio/93b2742f60dd.mp3"}},
    {"char": "带", "level": "G2-U10", "pinyin": "dài", "words": [{"word": "带领", "pinyin": ["dài", "lǐng"], "audio": "audio/13fa19451da8.mp3"}, {"word": "安全带", "pinyin": ["ān", "quán", "dài"], "audio": "audio/cb775ac9d5cf.mp3"}], "lesson": "10.6", "lessonTitle": "回声", "kind": "write", "audio": "audio/69b1baac5d7f.mp3", "sentence": {"text": "青蛙妈妈带着小青蛙跳到岸上。", "pinyin": ["qīng", "wā", "mā", "ma", "dài", "zhe", "xiǎo", "qīng", "wā", "tiào", "dào", "àn", "shàng", ""], "audio": "audio/1610b7f3c393.mp3"}},
    {"char": "捡", "level": "G2-U10", "pinyin": "jiǎn", "words": [{"word": "捡拾", "pinyin": ["jiǎn", "shí"], "audio": "audio/e2e591afe1ce.mp3"}, {"word": "捡了芝麻，丢了西瓜", "pinyin": ["jiǎn", "le", "zhī", "má", "", "diū", "le", "xī", "guā"], "audio": "audio/10afcaebf75b.mp3"}, {"word": "捡起", "pinyin": ["jiǎn", "qǐ"], "audio": "audio/0dd2287e3b87.mp3"}], "lesson": "10.6", "lessonTitle": "回声", "kind": "write", "audio": "audio/33009d040682.mp3", "sentence": {"text": "她捡起一颗石子，扔进河里，河水被激起一圈圈波纹。", "pinyin": ["tā", "jiǎn", "qǐ", "yì", "kē", "shí", "zǐ", "", "rēng", "jìn", "hé", "lǐ", "", "hé", "shuǐ", "bèi", "jī", "qǐ", "yì", "quān", "quān", "bō", "wén", ""], "audio": "audio/93b2742f60dd.mp3"}},
    {"char": "就", "level": "G2-U10", "pinyin": "jiù", "words": [{"word": "就像", "pinyin": ["jiù", "xiàng"], "audio": "audio/6bc29b34fdd2.mp3"}, {"word": "就要", "pinyin": ["jiù", "yào"], "audio": "audio/60d26cf52c57.mp3"}], "lesson": "10.6", "lessonTitle": "回声", "kind": "write", "audio": "audio/41737f683750.mp3", "sentence": {"text": "青蛙妈妈说：“孩子，你的叫声就像这水的波纹。”", "pinyin": ["qīng", "wā", "mā", "ma", "shuō", "", "", "hái", "zi", "", "nǐ", "de", "jiào", "shēng", "jiù", "xiàng", "zhè", "shuǐ", "de", "bō", "wén", "", ""], "audio": "audio/ee4d5b7c05e9.mp3"}},
    {"char": "荡", "level": "G2-U10", "pinyin": "dàng", "words": [{"word": "摇荡", "pinyin": ["yáo", "dàng"], "audio": "audio/e426317d930e.mp3"}, {"word": "荡秋千", "pinyin": ["dàng", "qiū", "qiān"], "audio": "audio/7047de5dd176.mp3"}], "lesson": "10.6", "lessonTitle": "回声", "kind": "recognize", "audio": "audio/15e717c93aef.mp3", "sentence": {"text": "水的波纹碰到河岸又荡回来。", "pinyin": ["shuǐ", "de", "bō", "wén", "pèng", "dào", "hé", "àn", "yòu", "dàng", "huí", "lái", ""], "audio": "audio/c855644f1999.mp3"}},
    {"char": "返", "level": "G2-U10", "pinyin": "fǎn", "words": [{"word": "返回", "pinyin": ["fǎn", "huí"], "audio": "audio/2e26e478d360.mp3"}, {"word": "往返", "pinyin": ["wǎng", "fǎn"], "audio": "audio/34ed3d7c5d03.mp3"}], "lesson": "10.6", "lessonTitle": "回声", "kind": "recognize", "audio": "audio/7e46d87c572f.mp3", "sentence": {"text": "你在桥洞里叫，声音的波纹碰到桥洞的石壁，也要返回来。", "pinyin": ["nǐ", "zài", "qiáo", "dòng", "lǐ", "jiào", "", "shēng", "yīn", "de", "bō", "wén", "pèng", "dào", "qiáo", "dòng", "de", "shí", "bì", "", "yě", "yào", "fǎn", "huí", "lái", ""], "audio": "audio/c0704446cd78.mp3"}},
    {"char": "蹦", "level": "G2-U10", "pinyin": "bèng", "words": [{"word": "蹦跳", "pinyin": ["bèng", "tiào"], "audio": "audio/2b70f3aeff08.mp3"}, {"word": "活蹦乱跳", "pinyin": ["huó", "bèng", "luàn", "tiào"], "audio": "audio/614382631f79.mp3"}], "lesson": "10.6", "lessonTitle": "回声", "kind": "recognize", "audio": "audio/a67ce7a17af8.mp3", "sentence": {"text": "小青蛙高兴得一蹦老高，说：“妈妈，我明白了，这就是回声吧？”", "pinyin": ["xiǎo", "qīng", "wā", "gāo", "xìng", "de", "yí", "bèng", "lǎo", "gāo", "", "shuō", "", "", "mā", "ma", "", "wǒ", "míng", "bai", "le", "", "zhè", "jiù", "shì", "huí", "shēng", "ba", "", ""], "audio": "audio/2c9257c877ff.mp3"}},
    {"char": "必", "level": "G2-U10", "pinyin": "bì", "words": [{"word": "必须", "pinyin": ["bì", "xū"], "audio": "audio/c5bc78824b43.mp3"}, {"word": "必需", "pinyin": ["bì", "xū"], "audio": "audio/aa3983f17651.mp3"}], "lesson": "10.7", "lessonTitle": "太空生活趣事多", "kind": "write", "audio": "audio/cf853d984e3e.mp3", "sentence": {"text": "不过，要想睡个安稳觉，航天员必须钻入固定在舱壁上的睡袋里。", "pinyin": ["bú", "guò", "", "yào", "xiǎng", "shuì", "gè", "ān", "wěn", "jiào", "", "háng", "tiān", "yuán", "bì", "xū", "zuān", "rù", "gù", "dìng", "zài", "cāng", "bì", "shàng", "de", "shuì", "dài", "lǐ", ""], "audio": "audio/ce1de0fe7114.mp3"}},
    {"char": "固", "level": "G2-U10", "pinyin": "gù", "words": [{"word": "固定", "pinyin": ["gù", "dìng"], "audio": "audio/40178ea733bf.mp3"}, {"word": "固体", "pinyin": ["gù", "tǐ"], "audio": "audio/38a16c708e01.mp3"}], "lesson": "10.7", "lessonTitle": "太空生活趣事多", "kind": "write", "audio": "audio/b51c5c22f5a7.mp3", "sentence": {"text": "不过，要想睡个安稳觉，航天员必须钻入固定在舱壁上的睡袋里。", "pinyin": ["bú", "guò", "", "yào", "xiǎng", "shuì", "gè", "ān", "wěn", "jiào", "", "háng", "tiān", "yuán", "bì", "xū", "zuān", "rù", "gù", "dìng", "zài", "cāng", "bì", "shàng", "de", "shuì", "dài", "lǐ", ""], "audio": "audio/ce1de0fe7114.mp3"}},
    {"char": "杯", "level": "G2-U10", "pinyin": "bēi", "words": [{"word": "杯子", "pinyin": ["bēi", "zi"], "audio": "audio/03331cbf6cd3.mp3"}, {"word": "保温杯", "pinyin": ["bǎo", "wēn", "bēi"], "audio": "audio/c9486ed0ad14.mp3"}, {"word": "奖杯", "pinyin": ["jiǎng", "bēi"], "audio": "audio/016e63d6e981.mp3"}], "lesson": "10.7", "lessonTitle": "太空生活趣事多", "kind": "write", "audio": "audio/7aaa6c0b1681.mp3", "sentence": {"text": "在空间站里，是没有办法用普通的杯子喝水的。", "pinyin": ["zài", "kōng", "jiān", "zhàn", "lǐ", "", "shì", "méi", "yǒu", "bàn", "fǎ", "yòng", "pǔ", "tōng", "de", "bēi", "zi", "hē", "shuǐ", "de", ""], "audio": "audio/0f83072aef76.mp3"}},
    {"char": "航", "level": "G2-U10", "pinyin": "háng", "words": [{"word": "航天员", "pinyin": ["háng", "tiān", "yuán"], "audio": "audio/748ac1a9c05c.mp3"}, {"word": "航班", "pinyin": ["háng", "bān"], "audio": "audio/0b9d7a0b2f00.mp3"}], "lesson": "10.7", "lessonTitle": "太空生活趣事多", "kind": "recognize", "audio": "audio/e2168df80054.mp3", "sentence": {"text": "航天员在太空中洗澡可不是一件容易的事。", "pinyin": ["háng", "tiān", "yuán", "zài", "tài", "kōng", "zhōng", "xǐ", "zǎo", "kě", "bú", "shì", "yí", "jiàn", "róng", "yì", "de", "shì", ""], "audio": "audio/4a5c7cea7ff4.mp3"}},
    {"char": "舱", "level": "G2-U10", "pinyin": "cāng", "words": [{"word": "舱体", "pinyin": ["cāng", "tǐ"], "audio": "audio/43649e6d5634.mp3"}, {"word": "舱壁", "pinyin": ["cāng", "bì"], "audio": "audio/6c063764d2d7.mp3"}, {"word": "机舱", "pinyin": ["jī", "cāng"], "audio": "audio/43857d5fce27.mp3"}, {"word": "头等舱", "pinyin": ["tóu", "děng", "cāng"], "audio": "audio/37885b2c6bfc.mp3"}], "lesson": "10.7", "lessonTitle": "太空生活趣事多", "kind": "recognize", "audio": "audio/92826d98eaf0.mp3", "sentence": {"text": "跟在地面上用腿脚行走不同，航天员在舱体里移动主要靠手臂。", "pinyin": ["gēn", "zài", "dì", "miàn", "shàng", "yòng", "tuǐ", "jiǎo", "xíng", "zǒu", "bù", "tóng", "", "háng", "tiān", "yuán", "zài", "cāng", "tǐ", "lǐ", "yí", "dòng", "zhǔ", "yào", "kào", "shǒu", "bì", ""], "audio": "audio/9a77e46c1cf2.mp3"}},
    {"char": "题", "level": "G2-U10", "pinyin": "tí", "words": [{"word": "问题", "pinyin": ["wèn", "tí"], "audio": "audio/ce62236ee2ce.mp3"}, {"word": "一道题", "pinyin": ["yí", "dào", "tí"], "audio": "audio/687b07ca878a.mp3"}], "lesson": "10.7", "lessonTitle": "太空生活趣事多", "kind": "recognize", "audio": "audio/a8b0b2bd178a.mp3", "sentence": {"text": "从喷头喷出的水总是飘浮在空中，为了解决这个问题，科研人员做了一个试验。", "pinyin": ["cóng", "pēn", "tóu", "pēn", "chū", "de", "shuǐ", "zǒng", "shì", "piāo", "fú", "zài", "kōng", "zhōng", "", "wèi", "le", "jiě", "jué", "zhè", "ge", "wèn", "tí", "", "kē", "yán", "rén", "yuán", "zuò", "le", "yí", "gè", "shì", "yàn", ""], "audio": "audio/1ecfdb32613e.mp3"}},
    {"char": "饮", "level": "G2-U10", "pinyin": "yǐn", "words": [{"word": "饮水袋", "pinyin": ["yǐn", "shuǐ", "dài"], "audio": "audio/468b94ab5486.mp3"}, {"word": "饮料", "pinyin": ["yǐn", "liào"], "audio": "audio/2f28aa957bb6.mp3"}], "lesson": "10.8", "lessonTitle": "太空生活趣事多", "kind": "write", "audio": "audio/ecfa5a577bcd.mp3", "sentence": {"text": "航天员要想喝到水，得使用一种带吸管的饮水袋，直接把水挤到嘴里。", "pinyin": ["háng", "tiān", "yuán", "yào", "xiǎng", "hē", "dào", "shuǐ", "", "děi", "shǐ", "yòng", "yì", "zhǒng", "dài", "xī", "guǎn", "de", "yǐn", "shuǐ", "dài", "", "zhí", "jiē", "bǎ", "shuǐ", "jǐ", "dào", "zuǐ", "lǐ", ""], "audio": "audio/2d853482e969.mp3"}},
    {"char": "件", "level": "G2-U10", "pinyin": "jiàn", "words": [{"word": "一件事", "pinyin": ["yí", "jiàn", "shì"], "audio": "audio/40ea0a09d1f2.mp3"}, {"word": "一件衣服", "pinyin": ["yí", "jiàn", "yī", "fu"], "audio": "audio/c0dc34b0d6ab.mp3"}, {"word": "一件礼物", "pinyin": ["yí", "jiàn", "lǐ", "wù"], "audio": "audio/8bd84f731e69.mp3"}, {"word": "摆件", "pinyin": ["bǎi", "jiàn"], "audio": "audio/878e8b990516.mp3"}], "lesson": "10.8", "lessonTitle": "太空生活趣事多", "kind": "write", "audio": "audio/e15d5e31afe5.mp3", "sentence": {"text": "航天员在太空中洗澡可不是一件容易的事。", "pinyin": ["háng", "tiān", "yuán", "zài", "tài", "kōng", "zhōng", "xǐ", "zǎo", "kě", "bú", "shì", "yí", "jiàn", "róng", "yì", "de", "shì", ""], "audio": "audio/4a5c7cea7ff4.mp3"}},
    {"char": "浴", "level": "G2-U10", "pinyin": "yù", "words": [{"word": "浴桶", "pinyin": ["yù", "tǒng"], "audio": "audio/a923b0bd150c.mp3"}, {"word": "沐浴", "pinyin": ["mù", "yù"], "audio": "audio/c668fecb3b01.mp3"}, {"word": "日光浴", "pinyin": ["rì", "guāng", "yù"], "audio": "audio/788e0d4b5556.mp3"}], "lesson": "10.8", "lessonTitle": "太空生活趣事多", "kind": "write", "audio": "audio/5a6464587fec.mp3", "sentence": {"text": "但洗完澡以后，航天员还要花很长时间清理身体上和浴桶里的水，实在太麻烦了。", "pinyin": ["dàn", "xǐ", "wán", "zǎo", "yǐ", "hòu", "", "háng", "tiān", "yuán", "hái", "yào", "huā", "hěn", "cháng", "shí", "jiān", "qīng", "lǐ", "shēn", "tǐ", "shàng", "hé", "yù", "tǒng", "lǐ", "de", "shuǐ", "", "shí", "zài", "tài", "má", "fan", "le", ""], "audio": "audio/821f0d439a13.mp3"}},
    {"char": "密", "level": "G2-U10", "pinyin": "mì", "words": [{"word": "密封", "pinyin": ["mì", "fēng"], "audio": "audio/75d5790a34ef.mp3"}, {"word": "密码", "pinyin": ["mì", "mǎ"], "audio": "audio/472238c68fb7.mp3"}], "lesson": "10.8", "lessonTitle": "太空生活趣事多", "kind": "recognize", "audio": "audio/916f0d60d9c4.mp3", "sentence": {"text": "他们设计了一个密封浴桶，在下边安装吸管，它可以把喷头喷出的水朝一个方向吸。", "pinyin": ["tā", "men", "shè", "jì", "le", "yí", "gè", "mì", "fēng", "yù", "tǒng", "", "zài", "xià", "biān", "ān", "zhuāng", "xī", "guǎn", "", "tā", "kě", "yǐ", "bǎ", "pēn", "tóu", "pēn", "chū", "de", "shuǐ", "cháo", "yí", "gè", "fāng", "xiàng", "xī", ""], "audio": "audio/95be55a91007.mp3"}},
    {"char": "桶", "level": "G2-U10", "pinyin": "tǒng", "words": [{"word": "浴桶", "pinyin": ["yù", "tǒng"], "audio": "audio/a923b0bd150c.mp3"}, {"word": "垃圾桶", "pinyin": ["lā", "jī", "tǒng"], "audio": "audio/86f985a771aa.mp3"}, {"word": "桶装水", "pinyin": ["tǒng", "zhuāng", "shuǐ"], "audio": "audio/4e5a9ba4469a.mp3"}], "lesson": "10.8", "lessonTitle": "太空生活趣事多", "kind": "recognize", "audio": "audio/48b6b5d0839a.mp3", "sentence": {"text": "但洗完澡以后，航天员还要花很长时间清理身体上和浴桶里的水，实在太麻烦了。", "pinyin": ["dàn", "xǐ", "wán", "zǎo", "yǐ", "hòu", "", "háng", "tiān", "yuán", "hái", "yào", "huā", "hěn", "cháng", "shí", "jiān", "qīng", "lǐ", "shēn", "tǐ", "shàng", "hé", "yù", "tǒng", "lǐ", "de", "shuǐ", "", "shí", "zài", "tài", "má", "fan", "le", ""], "audio": "audio/821f0d439a13.mp3"}},
    {"char": "简", "level": "G2-U10", "pinyin": "jiǎn", "words": [{"word": "简单", "pinyin": ["jiǎn", "dān"], "audio": "audio/b027e4b58acc.mp3"}, {"word": "简短", "pinyin": ["jiǎn", "duǎn"], "audio": "audio/6cdf76f6be48.mp3"}], "lesson": "10.8", "lessonTitle": "太空生活趣事多", "kind": "recognize", "audio": "audio/92a1094a4d49.mp3", "sentence": {"text": "所以，现在航天员通常只用免洗湿巾擦拭身体，这就简单省事多了。", "pinyin": ["suǒ", "yǐ", "", "xiàn", "zài", "háng", "tiān", "yuán", "tōng", "cháng", "zhǐ", "yòng", "miǎn", "xǐ", "shī", "jīn", "cā", "shì", "shēn", "tǐ", "", "zhè", "jiù", "jiǎn", "dān", "shěng", "shì", "duō", "le", ""], "audio": "audio/f3271382fc65.mp3"}},
    {"char": "昆", "level": "G2-U10", "pinyin": "kūn", "words": [{"word": "昆虫", "pinyin": ["kūn", "chóng"], "audio": "audio/cd20565710da.mp3"}], "lesson": "10.9", "lessonTitle": "小毛虫", "kind": "write", "audio": "audio/ebc135c1d43e.mp3", "sentence": {"text": "一条小毛虫趴在一片叶子上，用新奇的目光打量着周围的一切：大大小小的昆虫又是唱，又是跳，跑的跑，飞的飞……", "pinyin": ["yì", "tiáo", "xiǎo", "máo", "chóng", "pā", "zài", "yí", "piàn", "yè", "zi", "shàng", "", "yòng", "xīn", "qí", "de", "mù", "guāng", "dǎ", "liang", "zhe", "zhōu", "wéi", "de", "yí", "qiè", "", "dà", "dà", "xiǎo", "xiǎo", "de", "kūn", "chóng", "yòu", "shì", "chàng", "", "yòu", "shì", "tiào", "", "pǎo", "de", "pǎo", "", "fēi", "de", "fēi", "", ""], "audio": "audio/354d8761421e.mp3"}},
    {"char": "怜", "level": "G2-U10", "pinyin": "lián", "words": [{"word": "可怜", "pinyin": ["kě", "lián"], "audio": "audio/b318c0f8dd3f.mp3"}], "lesson": "10.9", "lessonTitle": "小毛虫", "kind": "write", "audio": "audio/b6a2a9aee959.mp3", "sentence": {"text": "只有它，这个可怜的小毛虫，既不会唱，也不会跑，更不会飞。", "pinyin": ["zhǐ", "yǒu", "tā", "", "zhè", "ge", "kě", "lián", "de", "xiǎo", "máo", "chóng", "", "jì", "bú", "huì", "chàng", "", "yě", "bú", "huì", "pǎo", "", "gèng", "bú", "huì", "fēi", ""], "audio": "audio/5036a1cd5e33.mp3"}},
    {"char": "纺", "level": "G2-U10", "pinyin": "fǎng", "words": [{"word": "纺织", "pinyin": ["fǎng", "zhī"], "audio": "audio/e6b9d9bb9c65.mp3"}], "lesson": "10.9", "lessonTitle": "小毛虫", "kind": "write", "audio": "audio/3f811bf6133f.mp3", "sentence": {"text": "它，一条小小的毛虫，眼前最要紧的是学会抽丝纺织，为自己编织一间牢固的茧屋。", "pinyin": ["tā", "", "yì", "tiáo", "xiǎo", "xiǎo", "de", "máo", "chóng", "", "yǎn", "qián", "zuì", "yào", "jǐn", "de", "shì", "xué", "huì", "chōu", "sī", "fǎng", "zhī", "", "wèi", "zì", "jǐ", "biān", "zhī", "yì", "jiān", "láo", "gù", "de", "jiǎn", "wū", ""], "audio": "audio/7f0c15e34d3c.mp3"}},
    {"char": "挪", "level": "G2-U10", "pinyin": "nuó", "words": [{"word": "挪动", "pinyin": ["nuó", "dòng"], "audio": "audio/7e376706c805.mp3"}, {"word": "挪一挪", "pinyin": ["nuó", "yi", "nuó"], "audio": "audio/389be0b967d0.mp3"}], "lesson": "10.9", "lessonTitle": "小毛虫", "kind": "recognize", "audio": "audio/447990d9b625.mp3", "sentence": {"text": "小毛虫费了九牛二虎之力，才挪动了一点点。", "pinyin": ["xiǎo", "máo", "chóng", "fèi", "le", "jiǔ", "niú", "èr", "hǔ", "zhī", "lì", "", "cái", "nuó", "dòng", "le", "yì", "diǎn", "diǎn", ""], "audio": "audio/d9eb48bfc0a1.mp3"}},
    {"char": "规", "level": "G2-U10", "pinyin": "guī", "words": [{"word": "规律", "pinyin": ["guī", "lǜ"], "audio": "audio/b709f02df30b.mp3"}, {"word": "规则", "pinyin": ["guī", "zé"], "audio": "audio/c6bfe9862ce3.mp3"}], "lesson": "10.9", "lessonTitle": "小毛虫", "kind": "recognize", "audio": "audio/8007ce0d925b.mp3", "sentence": {"text": "“万事万物都有自己的规律！”", "pinyin": ["", "wàn", "shì", "wàn", "wù", "dōu", "yǒu", "zì", "jǐ", "de", "guī", "lǜ", "", ""], "audio": "audio/08bd8d9f549c.mp3"}},
    {"char": "律", "level": "G2-U10", "pinyin": "lǜ", "words": [{"word": "规律", "pinyin": ["guī", "lǜ"], "audio": "audio/b709f02df30b.mp3"}, {"word": "自律", "pinyin": ["zì", "lǜ"], "audio": "audio/0b42b9b80916.mp3"}, {"word": "法律", "pinyin": ["fǎ", "lǜ"], "audio": "audio/8b592553ed00.mp3"}], "lesson": "10.9", "lessonTitle": "小毛虫", "kind": "recognize", "audio": "audio/1a8fd7b59118.mp3", "sentence": {"text": "“万事万物都有自己的规律！”", "pinyin": ["", "wàn", "shì", "wàn", "wù", "dōu", "yǒu", "zì", "jǐ", "de", "guī", "lǜ", "", ""], "audio": "audio/08bd8d9f549c.mp3"}},
    {"char": "任", "level": "G2-U10", "pinyin": "rèn", "words": [{"word": "任何", "pinyin": ["rèn", "hé"], "audio": "audio/900d54165bea.mp3"}, {"word": "信任", "pinyin": ["xìn", "rèn"], "audio": "audio/ba01a292d5e6.mp3"}], "lesson": "10.10", "lessonTitle": "小毛虫", "kind": "write", "audio": "audio/db29bb75a339.mp3", "sentence": {"text": "尽管如此，它并不悲观失望，也不羡慕任何人。", "pinyin": ["jǐn", "guǎn", "rú", "cǐ", "", "tā", "bìng", "bù", "bēi", "guān", "shī", "wàng", "", "yě", "bú", "xiàn", "mù", "rèn", "hé", "rén", ""], "audio": "audio/e78c8f130f45.mp3"}},
    {"char": "何", "level": "G2-U10", "pinyin": "hé", "words": [{"word": "任何", "pinyin": ["rèn", "hé"], "audio": "audio/900d54165bea.mp3"}], "lesson": "10.10", "lessonTitle": "小毛虫", "kind": "write", "audio": "audio/4268ad252de1.mp3", "sentence": {"text": "尽管如此，它并不悲观失望，也不羡慕任何人。", "pinyin": ["jǐn", "guǎn", "rú", "cǐ", "", "tā", "bìng", "bù", "bēi", "guān", "shī", "wàng", "", "yě", "bú", "xiàn", "mù", "rèn", "hé", "rén", ""], "audio": "audio/e78c8f130f45.mp3"}},
    {"char": "愉", "level": "G2-U10", "pinyin": "yú", "words": [{"word": "愉快", "pinyin": ["yú", "kuài"], "audio": "audio/0355e7c2ce94.mp3"}, {"word": "愉悦", "pinyin": ["yú", "yuè"], "audio": "audio/845c46d7a14e.mp3"}], "lesson": "10.10", "lessonTitle": "小毛虫", "kind": "write", "audio": "audio/d44457a4993d.mp3", "sentence": {"text": "它愉快地舞动了一下翅膀，如绒毛一般，从叶子上飘然而起。", "pinyin": ["tā", "yú", "kuài", "de", "wǔ", "dòng", "le", "yí", "xià", "chì", "bǎng", "", "rú", "róng", "máo", "yì", "bān", "", "cóng", "yè", "zi", "shàng", "piāo", "rán", "ér", "qǐ", ""], "audio": "audio/ab051dc17592.mp3"}},
    {"char": "竭", "level": "G2-U10", "pinyin": "jié", "words": [{"word": "尽心竭力", "pinyin": ["jìn", "xīn", "jié", "lì"], "audio": "audio/ad9f5b4e7ba0.mp3"}, {"word": "枯竭", "pinyin": ["kū", "jié"], "audio": "audio/bdb56e4154c4.mp3"}], "lesson": "10.10", "lessonTitle": "小毛虫", "kind": "recognize", "audio": "audio/ed974c69cf26.mp3", "sentence": {"text": "小毛虫一刻也没有迟疑，尽心竭力地工作着。", "pinyin": ["xiǎo", "máo", "chóng", "yí", "kè", "yě", "méi", "yǒu", "chí", "yí", "", "jìn", "xīn", "jié", "lì", "de", "gōng", "zuò", "zhe", ""], "audio": "audio/7dd1cfc78e18.mp3"}},
    {"char": "挣", "level": "G2-U10", "pinyin": "zhèng", "words": [{"word": "挣脱", "pinyin": ["zhèng", "tuō"], "audio": "audio/107a0be02ff4.mp3"}, {"word": "挣钱", "pinyin": ["zhèng", "qián"], "audio": "audio/8fe626cb2cbe.mp3"}], "lesson": "10.10", "lessonTitle": "小毛虫", "kind": "recognize", "audio": "audio/fc0df54927cd.mp3", "sentence": {"text": "它灵巧地从茧子里挣脱出来，惊奇地发现自己身上生出了轻盈的翅膀，上面布满色彩斑斓的花纹。", "pinyin": ["tā", "líng", "qiǎo", "de", "cóng", "jiǎn", "zi", "lǐ", "zhèng", "tuō", "chū", "lái", "", "jīng", "qí", "de", "fā", "xiàn", "zì", "jǐ", "shēn", "shàng", "shēng", "chū", "le", "qīng", "yíng", "de", "chì", "bǎng", "", "shàng", "miàn", "bù", "mǎn", "sè", "cǎi", "bān", "lán", "de", "huā", "wén", ""], "audio": "audio/a06eef5c6dd7.mp3"}},
    {"char": "绒", "level": "G2-U10", "pinyin": "róng", "words": [{"word": "绒毛", "pinyin": ["róng", "máo"], "audio": "audio/1b075f4c5831.mp3"}, {"word": "羽绒服", "pinyin": ["yǔ", "róng", "fú"], "audio": "audio/43ef388051cd.mp3"}], "lesson": "10.10", "lessonTitle": "小毛虫", "kind": "recognize", "audio": "audio/420fbfe9f5ed.mp3", "sentence": {"text": "它愉快地舞动了一下翅膀，如绒毛一般，从叶子上飘然而起。", "pinyin": ["tā", "yú", "kuài", "de", "wǔ", "dòng", "le", "yí", "xià", "chì", "bǎng", "", "rú", "róng", "máo", "yì", "bān", "", "cóng", "yè", "zi", "shàng", "piāo", "rán", "ér", "qǐ", ""], "audio": "audio/ab051dc17592.mp3"}}
