    {"char": "浪", "level": "G2-U10", "pinyin": "làng", "words": [{"word": "波浪", "pinyin": ["bō", "làng"], "audio": "audio/8116996d0327.mp3"}, {"word": "浪费", "pinyin": ["làng", "fèi"], "audio": "audio/b9351b0afbaf.mp3"}], "lesson": "10.3", "lessonTitle": "最大的“书”", "kind": "write", "audio": "audio/ae384a441b5e.mp3", "sentence": {"text": "这是波浪的足迹，叫波痕。", "pinyin": ["zhè", "shì", "bō", "làng", "de", "zú", "jì", "", "jiào", "bō", "hén", ""], "audio": "audio/0d588ae0539f.mp3"}},
