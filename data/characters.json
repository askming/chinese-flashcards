    {"char": "稠", "level": "G2-U10", "pinyin": "chóu", "words": [{"word": "粘稠", "pinyin": ["nián", "chóu"], "audio": "audio/5d0ebd9d7338.mp3"}], "lesson": "10.2", "lessonTitle": "要是你在野外迷了路", "kind": "recognize", "audio": "audio/b48a156479b8.mp3", "sentence": {"text": "枝叶稠的一面是南方，枝叶稀的一面是北方。", "pinyin": ["zhī", "yè", "chóu", "de", "yí", "miàn", "shì", "nán", "fāng", "", "zhī", "yè", "xī", "de", "yí", "miàn", "shì", "běi", "fāng", ""], "audio": "audio/2e19e2fbd8fc.mp3"}},
