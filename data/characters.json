    {"char": "陆", "level": "G2-U10", "pinyin": "lù", "words": [{"word": "陆地", "pinyin": ["lù", "dì"], "audio": "audio/c44fbbeae494.mp3"}, {"word": "水陆交通", "pinyin": ["shuǐ", "lù", "jiāo", "tōng"], "audio": "audio/b560ce74e857.mp3"}], "lesson": "10.4", "lessonTitle": "最大的“书”", "kind": "recognize", "audio": "audio/9de4dacac252.mp3", "sentence": {"text": "后来，陆地沉下去了，这里就变成了大海。", "pinyin": ["hòu", "lái", "", "lù", "dì", "chén", "xià", "qù", "le", "", "zhè", "lǐ", "jiù", "biàn", "chéng", "le", "dà", "hǎi", ""], "audio": "audio/83560c8c07ed.mp3"}},
